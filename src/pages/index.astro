---
const ventures = [
  { name: 'Musubi', url: 'https://musubi.social', domain: 'musubi.social' },
  { name: 'Cire', url: 'https://cireweddings.com', domain: 'cireweddings.com' },
];

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="English Street Ventures" />
    <title>English Street Ventures</title>
  </head>
  <body>
    <button class="lamp-toggle" type="button" aria-label="Toggle light and dark mode" aria-pressed="false">
      <svg viewBox="0 0 48 96" aria-hidden="true">
        <path class="cord" d="M24 0v27" />
        <g class="bulb-drop">
          <g transform="rotate(180 24 50.5)">
            <path class="bulb" d="M24 27c-9 0-16 7-16 16 0 5 2 8 5 11l4 5c1 1 2 3 2 5v2h-1v3c0 3 3 5 6 5s6-2 6-5v-3h-1v-2c0-2 .8-4 2-5l4-5c3-3 5-6 5-11 0-9-7-16-16-16Z" />
          </g>
        </g>
      </svg>
    </button>
    <main class="page">
      <header>
        <h1>English Street Ventures</h1>
      </header>

      <section class="details" aria-label="Company information">
        <div class="group ventures">
          <h2>Ventures</h2>
          <ul>
            {ventures.map((venture) => (
              <li>
                <span>{venture.name}</span>
                <a class="domain" href={venture.url} target="_blank" rel="noopener noreferrer">{venture.domain}</a>
              </li>
            ))}
          </ul>
        </div>

        <div class="group registration">
          <h2>Registration</h2>
          <p><span>ABN</span><span>25 693 716 700</span></p>
          <p><span>ACN</span><span>693 716 700</span></p>
        </div>

        <div class="group contact">
          <h2>Contact</h2>
          <a href="mailto:hello@englishstreetventures.com">hello@englishstreetventures.com</a>
        </div>

        <div class="group github">
          <h2>GitHub</h2>
          <a href="https://github.com/englishstreetventures" target="_blank" rel="noopener noreferrer">englishstreetventures</a>
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { min-width: 320px; background: var(--paper); }
  :global(body) { margin: 0; color: var(--ink); background: var(--paper); font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 14px; line-height: 1.7; }
  :global(a) { color: inherit; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  :global(:root) { --paper: #f4f1e8; --ink: #211f1a; --muted: #625e55; --rule: #777268; }
  :global(html.dark) { --paper: #171714; --ink: #eeeae0; --muted: #b0aa9c; --rule: #777268; }

  .page { width: min(calc(100% - 48px), 680px); min-height: 100svh; margin: 0 auto; padding: 72px 0 64px; }
  header { padding-bottom: 25px; border-bottom: 1px solid var(--rule); }
  h1 { margin: 0; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(22px, 4.4vw, 28px); line-height: 1.35; font-weight: 700; letter-spacing: -.035em; }
  .lamp-toggle { position: fixed; z-index: 5; top: 0; right: max(22px, calc((100vw - 680px) / 2)); width: 42px; height: 90px; display: grid; place-items: start center; padding: 0; border: 0; background: transparent; color: var(--ink); cursor: pointer; -webkit-tap-highlight-color: transparent; }
  .lamp-toggle svg { width: 38px; height: 76px; overflow: visible; transform-origin: 50% 0; transition: color .25s; }
  .lamp-toggle .cord { fill: none; stroke: var(--bulb-stroke); stroke-width: 1.5; stroke-linecap: round; transform-box: view-box; transform-origin: 50% 0; transition: transform 150ms cubic-bezier(.2,.7,.3,1); }
  .lamp-toggle .bulb-drop { transform-box: view-box; transition: transform 150ms cubic-bezier(.2,.7,.3,1); }
  .lamp-toggle .bulb { fill: var(--bulb-fill); stroke: var(--bulb-stroke); stroke-width: 2.8; stroke-linecap: round; stroke-linejoin: round; transition: fill .25s, stroke .25s; }
  .lamp-toggle:hover { color: var(--ink); }
  .lamp-toggle:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; border-radius: 24px; }
  .lamp-toggle.pulling .cord { transform: scaleY(1.4444); }
  .lamp-toggle.pulling .bulb-drop { transform: translateY(12px); }

  .details { display: grid; grid-template-columns: 1fr 1fr; column-gap: 48px; row-gap: 34px; padding-top: 34px; }
  .group h2 { margin: 0 0 12px; color: var(--muted); font: inherit; font-size: 12px; font-weight: 400; }
  .group ul { margin: 0; padding: 0; list-style: none; }
  .group li { display: flex; flex-wrap: wrap; gap: 0 10px; margin: 0 0 8px; }
  .group li a { display: inline; }
  .domain { color: var(--muted); }
  .registration p { display: flex; gap: 12px; margin: 0 0 5px; }
  .contact > a { display: inline-block; }

  :global(:root) { --bulb-fill: #f4f1e8; --bulb-stroke: #211f1a; }
  :global(html.dark) { --bulb-fill: #171714; --bulb-stroke: #b0aa9c; }
  :global(body), :global(html) { transition: background-color .35s ease, color .35s ease; }
  :global(::view-transition-old(root)) { z-index: 1; animation: none; }
  :global(::view-transition-new(root)) { z-index: 2; animation: lamp-reveal 680ms cubic-bezier(.2,.75,.25,1) both; }
  @keyframes lamp-reveal {
    from { clip-path: circle(0 at var(--reveal-x) var(--reveal-y)); }
    to { clip-path: circle(var(--reveal-radius) at var(--reveal-x) var(--reveal-y)); }
  }

  @media (max-width: 560px) {
    .page { width: min(calc(100% - 40px), 420px); padding: 42px 0; }
    .details { grid-template-columns: 1fr; row-gap: 26px; padding-top: 28px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .lamp-toggle .cord, .lamp-toggle .bulb-drop { transition-duration: .01ms; }
    :global(html), :global(body) { transition-duration: .01ms; }
  }
</style>

<script>
  import { WebHaptics } from 'web-haptics';

  const lamp = document.querySelector<HTMLButtonElement>('.lamp-toggle');
  const haptics = new WebHaptics();

  lamp?.addEventListener('click', () => {
    const root = document.documentElement;
    const turningDark = !root.classList.contains('dark');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const pullDuration = reducedMotion ? 0 : 150;

    lamp.disabled = true;
    lamp.classList.add('pulling');

    window.setTimeout(() => {
      void haptics.trigger([{ duration: 25, intensity: 0.35 }]).catch(() => {});
      const bulb = lamp.querySelector<SVGPathElement>('.bulb');
      const bounds = bulb?.getBoundingClientRect() ?? lamp.getBoundingClientRect();
      const x = bounds.left + bounds.width / 2;
      const y = bounds.top + bounds.height / 2;
      const endRadius = Math.hypot(
        Math.max(x, window.innerWidth - x),
        Math.max(y, window.innerHeight - y),
      );
      const updateTheme = () => root.classList.toggle('dark', turningDark);

      lamp.setAttribute('aria-pressed', String(turningDark));
      const releaseLamp = () => {
        lamp.classList.remove('pulling');
        lamp.disabled = false;
      };

      if ('startViewTransition' in document && !reducedMotion) {
        root.style.setProperty('--reveal-x', `${x}px`);
        root.style.setProperty('--reveal-y', `${y}px`);
        root.style.setProperty('--reveal-radius', `${Math.ceil(endRadius + 40)}px`);
        document.startViewTransition(updateTheme);
        releaseLamp();
      } else {
        updateTheme();
        releaseLamp();
      }
    }, pullDuration);
  });
</script>
